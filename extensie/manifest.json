{
  "manifest_version": 3,
  "name": "ffwd addon",
  "version": "0.3.0",
  "description": "Extra functions inside app.ffwd.school: a progress card on each student page and next to each assessment, and an EC overview of all students. Personal use only.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.ffwd.school/*"
      ],
      "css": [
        "ec-overzicht.css",
        "statuskaart.css",
        "assessment-aside.css"
      ],
      "js": [
        "gedeeld.js",
        "status.js",
        "ec-overzicht.js",
        "statuskaart.js",
        "assessment-aside.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
