{
  "manifest_version": 3,
  "name": "ffwd addon",
  "version": "1.0.0",
  "description": "Extra functions inside app.ffwd.school: a progress card on each student page and next to each assessment, the assessment list as rows, and an EC overview of all students. Reads only; nothing is stored or sent elsewhere.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.ffwd.school/*"
      ],
      "css": [
        "ec-overzicht.css",
        "statuskaart.css",
        "assessment-aside.css",
        "assessmentlijst.css"
      ],
      "js": [
        "gedeeld.js",
        "status.js",
        "ec-overzicht.js",
        "statuskaart.js",
        "assessment-aside.js",
        "assessmentlijst.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
