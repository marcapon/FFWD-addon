{
  "manifest_version": 3,
  "name": "ffwd addon",
  "version": "1.1.0",
  "description": "Extra functions inside app.ffwd.school: a progress card on each student page and next to each assessment, the assessment list as rows, an EC overview of all students, and an export of a student's earlier feedback as Markdown. Reads only; nothing is stored or sent elsewhere.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ffwd-addon@marcapon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.ffwd.school/*"
      ],
      "css": [
        "ec-overzicht.css",
        "statuskaart.css",
        "assessment-aside.css",
        "assessmentlijst.css",
        "feedback.css"
      ],
      "js": [
        "gedeeld.js",
        "status.js",
        "ec-overzicht.js",
        "feedback.js",
        "statuskaart.js",
        "assessment-aside.js",
        "assessmentlijst.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
